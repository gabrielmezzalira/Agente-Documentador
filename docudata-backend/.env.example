# Use uma string longa e aleatória e repita o mesmo valor no frontend.
DOCUDATA_APP_SECRET=

# Chave Fernet exclusiva do backend para criptografar segredos persistidos.
# Gere com: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DOCUDATA_SECRETS_KEY=

# Origens permitidas, separadas por vírgula e sem wildcard.
ALLOWED_ORIGINS=http://localhost:3000

# Proteções contra uploads excessivos e chamadas pagas em loop.
MAX_UPLOAD_MB=20
RATE_LIMIT_PER_MINUTE=20

# Integração Google Docs/Drive. Client OAuth compartilhado, identidade por subárea.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_REFRESH_TOKEN_DEV=

# Templates de Dados: padrão e overrides opcionais por tipo de documento.
GDOCS_TEMPLATE_ID=
GDOCS_TEMPLATE_ID_PLANNING=
GDOCS_TEMPLATE_ID_REVIEW=
GDOCS_TEMPLATE_ID_RETROSPECTIVA=

# Templates de Dev são opcionais; quando vazios, reutilizam os equivalentes de Dados.
GDOCS_TEMPLATE_ID_DEV=
GDOCS_TEMPLATE_ID_PLANNING_DEV=
GDOCS_TEMPLATE_ID_REVIEW_DEV=
GDOCS_TEMPLATE_ID_RETROSPECTIVA_DEV=

# Dados mantém a variável legada; Dev usa uma pasta raiz separada.
GDRIVE_FOLDER_ID=
GDRIVE_FOLDER_ID_DEV=
