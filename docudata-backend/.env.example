# Credencial exclusiva de hooks e automações; nunca use prefixo NEXT_PUBLIC_.
DOCUDATA_APP_SECRET=

# Chave Fernet exclusiva do backend para criptografar segredos persistidos.
# Gere com: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DOCUDATA_SECRETS_KEY=

# Origens permitidas, separadas por vírgula e sem wildcard.
ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Banco e sessão de usuário.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
JWT_SECRET=

# Notificações por email.
RESEND_API_KEY=
RESEND_FROM=DocuData <onboarding@resend.dev>

# Proteções contra uploads excessivos e chamadas pagas em loop.
MAX_UPLOAD_MB=20
RATE_LIMIT_PER_MINUTE=20

# Limites específicos de autenticação, por IP. Contam antes de consultar o
# banco, então o 429 é igual para e-mail existente e inexistente.
AUTH_LOGIN_RATE_LIMIT_PER_MINUTE=5
AUTH_SIGNUP_RATE_LIMIT_PER_HOUR=3

# Guardas de processamento de imagem e PDF escaneado.
MAX_IMAGE_PIXELS=40000000
PDF_POPPLER_TIMEOUT_SECONDS=30

# Documentação interativa da API. Local: true. Produção: false — /docs,
# /redoc e /openapi.json passam a responder 404. /health não é afetado.
API_DOCS_ENABLED=true

# Integração Google Docs/Drive. Client OAuth compartilhado, identidade por subárea.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_REFRESH_TOKEN_DEV=

# Templates de Dados: padrão e overrides opcionais por tipo de documento.
GDOCS_TEMPLATE_ID=
GDOCS_TEMPLATE_ID_PLANNING=
GDOCS_TEMPLATE_ID_REVIEW=
GDOCS_TEMPLATE_ID_RETROSPECTIVA=

# Templates de Dev são opcionais; quando vazios, reutilizam os equivalentes de Dados.
GDOCS_TEMPLATE_ID_DEV=
GDOCS_TEMPLATE_ID_PLANNING_DEV=
GDOCS_TEMPLATE_ID_REVIEW_DEV=
GDOCS_TEMPLATE_ID_RETROSPECTIVA_DEV=

# Dados mantém a variável legada; Dev usa uma pasta raiz separada.
GDRIVE_FOLDER_ID=
GDRIVE_FOLDER_ID_DEV=

# GitHub App — rollout opt-in, inicialmente apenas para projetos Dev.
# Com a flag false, as demais variáveis podem ficar vazias e as tabelas novas não são consultadas.
GITHUB_INTEGRATION_ENABLED=false
GITHUB_INTEGRATION_SUBAREAS=dev
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# Cole o PEM completo; no Railway também pode usar quebras de linha como \\n.
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_CONNECTION_STATE_SECRET=
